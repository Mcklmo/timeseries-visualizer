{
  // "Workers with static assets": one Worker serves both the API route and
  // ./dist. Not Cloudflare Pages — there is no functions/ auto-routing here,
  // the routing lives in worker/index.js. See README "Deploying".
  "name": "activitymaxxer",
  "compatibility_date": "2026-08-07",
  "main": "worker/index.js",
  // The one canonical origin. Apex, no `www` — every canonical tag, sitemap
  // entry and og:url in the build output hardcodes exactly this form, so a
  // second hostname serving the same bytes is a duplicate-content split, not a
  // convenience. `custom_domain` makes Cloudflare provision the DNS record and
  // certificate itself; it requires the zone's nameservers to be delegated to
  // Cloudflare (a registrar CNAME at the apex will not do).
  "routes": [{ "pattern": "activitymaxxer.com", "custom_domain": true }],
  // Retires *.workers.dev. Without this the app stays reachable on two
  // indexable hostnames serving byte-identical content. It has to live here
  // rather than in the dashboard: toggling it in the UI alone is undone by the
  // next `wrangler deploy`.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    // Bound so worker/index.js can hand every non-API request straight back
    // to the static asset server.
    "binding": "ASSETS"
  },
  // Non-secret. The two secrets (GITHUB_TOKEN, TURNSTILE_SECRET_KEY) are set
  // with `wrangler secret put` in prod and live in .dev.vars locally.
  "vars": {
    "GITHUB_REPO_OWNER": "Mcklmo",
    "GITHUB_REPO_NAME": "timeseries-visualizer"
  },
  // Native rate limiting, keyed by CF-Connecting-IP in worker/routes/feedback.js.
  // namespace_id only has to be unique within this Cloudflare account; there is
  // nothing to provision in the dashboard for it.
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
