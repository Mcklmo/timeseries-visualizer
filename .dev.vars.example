# Template for .dev.vars (gitignored) — the Worker's local secrets for
# `wrangler dev`. Copy this file to .dev.vars and fill in real values.
# In production these are set once with `wrangler secret put <NAME>` instead.

# Fine-grained GitHub PAT, scoped to Mcklmo/timeseries-visualizer only, with
# the "Issues: write" repository permission and nothing else.
GITHUB_TOKEN=github_pat_your_token_scoped_to_this_repo_with_issues_write

# Cloudflare's published "always passes" Turnstile test secret — safe to commit
# and fine for local dev. Pair it with the matching test sitekey
# (1x00000000000000000000AA) in .env's VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
